{
  "name": "rx-components",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "deploy": "ng deploy --base-href=https://earthdmitriy.github.io/rx-evo/",
    "test": "ng test --watch=false",
    "test:file": "ng test --watch=false",
    "test:pack": "vitest run --config .langflower/nodes/vitest.config.ts",
    "test:watch": "ng test --watch",
    "test:report": "node scripts/test-report.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.html\" \"src/**/*.less\"",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:smoke": "playwright test -c e2e/playwright.config.ts --grep @smoke",
    "e2e:validate": "node e2e/validate-suite.mjs",
    "pages:validate": "node src/app/components/contesters/page-tests/validate.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^20.2.13",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@faker-js/faker": "^8.4.1",
    "@ngrx/signals": "21.1.1",
    "@rx-evo/operators": "^0.0.2",
    "@rx-evo/stateful-observable": "^0.0.2",
    "@tailwindcss/postcss": "^4.1.17",
    "marked": "^15.0.12",
    "mermaid": "^11.17.2",
    "ngxtension": "^4.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.5.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.56.1",
    "angular-cli-ghpages": "^2.0.3",
    "angular-eslint": "^22.6.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^27.0.1",
    "less": "^4.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vitest": "4.0.18"
  }
}
